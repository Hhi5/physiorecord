{
  "name": "physiorecord",
  "private": true,
  "version": "1.0.0",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "build:web": "VITE_APP_TARGET=web vite build",
    "build:android:web": "node scripts/sync-version.mjs && VITE_APP_TARGET=android vite build",
    "build:desktop:web": "node scripts/sync-version.mjs && VITE_APP_TARGET=desktop vite build",
    "sync:version": "node scripts/sync-version.mjs",
    "android:sync": "npm run build:android:web && npx cap sync android",
    "electron:start": "npm run build:desktop:web && npx electron .",
    "electron:dist": "npm run build:desktop:web && npx electron-builder --win nsis --publish never",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "vitest run src",
    "test:e2e": "playwright test",
    "check:licenses": "node scripts/check-licenses.mjs",
    "check:content": "node scripts/verify-content-licenses.mjs",
    "check:perf": "node scripts/check-perf-budget.mjs",
    "sbom": "node scripts/generate-sbom.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "konva": "^10.9.1",
    "lucide-react": "^0.546.0",
    "minisearch": "^7.2.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.0.1",
    "react-konva": "^19.3.2",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "puppeteer-core": "^25.16.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.1.0"
  }
}
