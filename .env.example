# =======================================================================
# PhysioRecord — Environment Variables Example
# Copy to `.env.local` for local overrides. Never commit real secrets.
# =======================================================================

# Build target: "web" (PWA), "android" (Capacitor APK), or "desktop" (Electron)
VITE_APP_TARGET=web

# Enable Public Demo Mode banner with CC0 synthetic patients ("true" or "false")
VITE_PUBLIC_DEMO=false

# Optional public Google OAuth Client ID for Desktop/Android E2EE Google Drive BYOC sync.
# Must be a public PKCE Client ID (*.apps.googleusercontent.com). Never put client secrets in VITE_* vars.
VITE_GOOGLE_OAUTH_CLIENT_ID=

# Enable E2E test hooks in dev mode only ("true" or "false"; ignored in production builds)
VITE_ENABLE_TEST_HOOKS=false

# Disable Vite HMR file watcher when running inside restricted preview containers ("true" or "false")
DISABLE_HMR=false

# -----------------------------------------------------------------------
# Optional Local/CI Release & Android Signing Variables (Build-Time Only)
# -----------------------------------------------------------------------

# Android release keystore alias & passwords (used by scripts/setup-android-keystore.mjs & Gradle)
ANDROID_KEY_ALIAS=physiorecord_release
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_PASSWORD=

# Release tag consumed by scripts/sync-version.mjs in CI (e.g. v1.1.0)
RELEASE_VERSION=